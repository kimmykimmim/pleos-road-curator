<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!--
      Gear position and brake pedal, read only, for deciding when the car is standing still.
      Only the read permission is declared: the app never sets a vehicle value, so none of the
      matching CONTROL_CAR_* permissions belong here.
    -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <application
        android:allowBackup="false"
        android:label="길 위의 큐레이터"
        android:icon="@drawable/ic_explorer"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">
        <!-- Pleos 2.1 supplies Car through its boot classpath module. Older AAOS uses this library. -->
        <uses-library android:name="android.car" android:required="false" />
        <service android:name=".CuratorDriveService" android:exported="false"
            android:foregroundServiceType="mediaPlayback|location" />
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="landscape"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
